params {
    slurm_partition = null
    slurm_account = null
}

process {
    errorStrategy = 'retry'

    withName: ASCAIRN_TYPE_ALL {
        memory = 32.GB
        time = '24h'
        maxForks = 5
    }
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            queue = params.slurm_partition
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
        }
    }
}

trace {
    enabled = true
    file = 'pipeline_info/trace.txt'
}

report {
    enabled = true
    file = 'pipeline_info/report.html'
}

timeline {
    enabled = true
    file = 'pipeline_info/timeline.html'
}